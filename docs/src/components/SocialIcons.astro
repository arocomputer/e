---
/**
 * The header's right side: the product site's links, then Starlight's own
 * social icons, so the docs keep the way back to e.intuitum.sh.
 */
import Default from "@astrojs/starlight/components/SocialIcons.astro";
---

<nav aria-label="e.intuitum.sh" class="sl-flex">
  <a href="https://e.intuitum.sh">Home</a>
  <a href="https://e.intuitum.sh/changelog">Changelog</a>
</nav>
<Default />

<style>
  nav {
    gap: 1.25rem;
    margin-inline-end: 0.5rem;
    font-size: var(--sl-text-sm);
  }
  a {
    color: var(--sl-color-gray-2);
    text-decoration: none;
  }
  a:hover {
    color: var(--sl-color-white);
  }
</style>
