---
/**
 * The page heading: the guide's title with its description beneath, so a
 * reader knows what the page covers before the first paragraph.
 */
// Starlight links "Overview" in the table of contents to this id.
const PAGE_TITLE_ID = "_top";

const { title, description } = Astro.locals.starlightRoute.entry.data;
---

<h1 id={PAGE_TITLE_ID}>{title}</h1>
{description && <p class="page-description">{description}</p>}

<style>
  h1 {
    margin-top: 1rem;
    font-size: var(--sl-text-h1);
    line-height: var(--sl-line-height-headings);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--sl-color-white);
  }
  .page-description {
    margin-top: 0.5rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-base);
    line-height: 1.5;
  }
</style>
