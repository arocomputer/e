---
/**
 * The package catalog: every npm package carrying the `e-package` keyword,
 * asked of the npm registry's search API in the reader's browser. No build
 * step and no server; the registry answers cross-origin requests.
 */
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
---

<StarlightPage
  frontmatter={{
    title: "Package catalog",
    description: "Extensions, skills, prompt templates, and themes published for e.",
    tableOfContents: false,
    editUrl: false,
  }}
>
  <p>
    Every npm package with the <code>e-package</code> keyword, straight from the
    registry. Install one with <code>e install npm:&lt;name&gt;</code>. A package
    runs with your full permissions; read the source before installing. See
    <a href="/docs/packages/">packages</a> to publish your own.
  </p>
  <div class="not-content catalog">
    <div class="controls">
      <input id="q" type="search" placeholder="filter by name, description, author, or keyword" autocomplete="off" />
      <select id="sort">
        <option value="downloads">most downloaded</option>
        <option value="recent">recently published</option>
        <option value="name">a–z</option>
      </select>
    </div>
    <div class="count" id="count">loading…</div>
    <div id="list"></div>
  </div>
</StarlightPage>

<script is:inline>
(async () => {
  const REGISTRY = "https://registry.npmjs.org/-/v1/search";
  const KINDS = ["extensions", "skills", "prompts", "themes"];
  const list = document.getElementById("list");
  const count = document.getElementById("count");
  const q = document.getElementById("q");
  const sort = document.getElementById("sort");
  let packages = [];

  // The search API pages at 250; walk it until the total is in hand.
  async function fetchAll() {
    const out = [];
    for (let from = 0; ; from += 250) {
      const url = `${REGISTRY}?text=keywords:e-package&size=250&from=${from}`;
      const res = await fetch(url);
      if (!res.ok) throw new Error(`registry answered ${res.status}`);
      const data = await res.json();
      out.push(...data.objects);
      if (out.length >= data.total || data.objects.length === 0) break;
    }
    return out.map((o) => ({
      name: o.package.name,
      version: o.package.version,
      description: o.package.description || "",
      author: (o.package.publisher && o.package.publisher.username) || "",
      keywords: (o.package.keywords || []).filter((k) => k !== "e-package"),
      kinds: KINDS.filter((k) => (o.package.keywords || []).includes(k)),
      date: o.package.date ? new Date(o.package.date) : null,
      downloads: (o.downloads && o.downloads.monthly) || 0,
      npm: o.package.links && o.package.links.npm,
      repo: o.package.links && o.package.links.repository,
    }));
  }

  function ago(date) {
    if (!date) return "";
    const days = Math.floor((Date.now() - date.getTime()) / 86400000);
    if (days < 1) return "today";
    if (days < 30) return `${days}d ago`;
    if (days < 365) return `${Math.floor(days / 30)}mo ago`;
    return `${Math.floor(days / 365)}y ago`;
  }

  function compact(n) {
    if (n >= 1e6) return `${(n / 1e6).toFixed(1)}M`;
    if (n >= 1e3) return `${(n / 1e3).toFixed(1)}K`;
    return String(n);
  }

  function escape(text) {
    return String(text).replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));
  }

  // Only registry-provided http(s) links are rendered.
  function safeUrl(url) {
    return typeof url === "string" && /^https?:\/\//i.test(url) ? url : null;
  }

  function render() {
    const needle = q.value.trim().toLowerCase();
    let shown = packages.filter((p) =>
      !needle ||
      [p.name, p.description, p.author, ...p.keywords].some((s) => s.toLowerCase().includes(needle))
    );
    const by = sort.value;
    shown.sort((a, b) =>
      by === "name" ? a.name.localeCompare(b.name)
      : by === "recent" ? (b.date ? b.date.getTime() : 0) - (a.date ? a.date.getTime() : 0)
      : b.downloads - a.downloads
    );
    count.textContent = `${shown.length} of ${packages.length} package${packages.length === 1 ? "" : "s"}`;
    if (shown.length === 0) {
      list.innerHTML = packages.length === 0
        ? `<p class="empty">Nothing published yet. Be first: <code>e packages init my-package</code>.</p>`
        : `<p class="empty">Nothing matches.</p>`;
      return;
    }
    list.innerHTML = shown.map((p) => {
      const npm = safeUrl(p.npm);
      const repo = safeUrl(p.repo && p.repo.replace(/^git\+/, "").replace(/\.git$/, ""));
      const tags = [...p.kinds, ...p.keywords.filter((k) => !KINDS.includes(k)).slice(0, 6)];
      return `<div class="card">
        <div class="links">${npm ? `<a href="${escape(npm)}">npm</a>` : ""}${repo ? `<a href="${escape(repo)}">source</a>` : ""}</div>
        <div class="head">
          ${npm ? `<a class="name" href="${escape(npm)}">${escape(p.name)}</a>` : `<span class="name">${escape(p.name)}</span>`}
          <span class="version">${escape(p.version)}</span>
          <span class="meta">${p.author ? `by ${escape(p.author)} · ` : ""}${compact(p.downloads)}/mo · ${ago(p.date)}</span>
        </div>
        ${p.description ? `<div class="desc">${escape(p.description)}</div>` : ""}
        ${tags.length ? `<div class="tags">${tags.map((t) => `<span class="tag">${escape(t)}</span>`).join("")}</div>` : ""}
        <code class="install">e install npm:${escape(p.name)}</code>
      </div>`;
    }).join("");
  }

  q.addEventListener("input", render);
  sort.addEventListener("change", render);
  try {
    packages = await fetchAll();
    render();
  } catch (error) {
    count.textContent = "";
    list.innerHTML = `<p class="error">Could not reach the npm registry (${escape(error.message)}). Search it directly: <a href="https://www.npmjs.com/search?q=keywords:e-package">npmjs.com/search?q=keywords:e-package</a>.</p>`;
  }
})();
</script>

<style is:global>
  .catalog { margin-top: 1.5rem; }
  .catalog .controls { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1rem; }
  .catalog input, .catalog select {
    font: inherit; font-size: var(--sl-text-sm); color: var(--sl-color-white);
    background: var(--sl-color-gray-6); border: 1px solid var(--sl-color-hairline-light);
    border-radius: 0.25rem; padding: 0.5rem 0.75rem;
  }
  .catalog input { flex: 1 1 15rem; min-width: 0; }
  .catalog .count, .catalog .empty, .catalog .error { color: var(--sl-color-gray-3); font-size: var(--sl-text-sm); }
  .catalog .count { margin-bottom: 0.75rem; }
  .catalog .empty, .catalog .error { padding: 1.5rem 0; }
  .catalog .card { border-top: 1px solid var(--sl-color-hairline); padding: 1rem 0; }
  .catalog .head { display: flex; flex-wrap: wrap; gap: 0.5rem 0.75rem; align-items: baseline; }
  .catalog .name { font-weight: 600; color: var(--sl-color-white); text-decoration: none; }
  .catalog .name:hover { text-decoration: underline; }
  .catalog .version, .catalog .meta, .catalog .links a { color: var(--sl-color-gray-3); font-size: var(--sl-text-xs); }
  .catalog .links { float: right; }
  .catalog .links a { margin-left: 0.75rem; }
  .catalog .desc { margin: 0.375rem 0 0.5rem; color: var(--sl-color-gray-2); }
  .catalog .tags { display: flex; flex-wrap: wrap; gap: 0.375rem; margin-bottom: 0.5rem; }
  .catalog .tag { font-size: var(--sl-text-xs); border: 1px solid var(--sl-color-hairline-light); border-radius: 999px; padding: 0 0.5rem; color: var(--sl-color-gray-3); }
  .catalog .install, .catalog code { font-family: var(--__sl-font-mono); font-size: var(--sl-text-xs); background: var(--sl-color-gray-6); border-radius: 0.25rem; padding: 0.125rem 0.375rem; user-select: all; }
</style>
