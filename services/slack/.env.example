# Slack app credentials (api.slack.com/apps → your app). Socket mode needs
# all three; no public URL.
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
SLACK_APP_TOKEN=xapp-...

# Required: explicit Slack user and channel IDs, separated by commas. Both
# must match for prompts, stop messages, and answers to extension questions.
E_SLACK_ALLOWED_USERS=U0123456789
E_SLACK_ALLOWED_CHANNELS=C0123456789

# The checkout e works in. One bot, one repository; run one bot per repo.
E_CWD=/srv/checkouts/app

# Optional: the e binary (default: `e` on PATH), a model, and where the
# thread → session map is kept so threads survive a restart.
# E_BIN=/usr/local/bin/e
# E_MODEL=anthropic/claude-opus-5
# E_SLACK_STATE=./e-slack-state.json
# E_SLACK_MAX_THREADS=16
# E_SLACK_IDLE_MS=900000
