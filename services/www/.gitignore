# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# astro / wrangler
/dist/
/.astro/
/.wrangler/
worker-configuration.d.ts
/public/pagefind/

# production
/build
/.next/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files and local Worker secrets
.env*
!.env.example
.dev.vars*

# typescript
*.tsbuildinfo

# Python recording tools
__pycache__/
*.pyc

# generated
/.ulo-docs-source/
/src/generated/
