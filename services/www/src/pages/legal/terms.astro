---
import Site from "@/layouts/Site.astro";
import LegalDocument, {
  type LegalSection,
} from "@/components/legal/LegalDocument.astro";
import SiteFrame from "@/components/SiteFrame.astro";
import { LEGAL_ENTITY } from "@/data/operator";
import "@/styles/legal.css";

