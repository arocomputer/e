---

<Site
  title="Terms"
  canonical="https://ulo.sh/legal/terms"
  og={{
    title: "Terms | ulo",
    url: "https://ulo.sh/legal/terms",
  }}
>
  <SiteFrame>
    <LegalDocument
      title="Terms of Service"
      updated="September 19, 2026"
      intro={`These terms are the agreement between you and ${LEGAL_ENTITY} for the use of ulo.sh and its related services. They are written to be read: plain about what we offer, what we ask of you, and where the limits lie.`}
      sections={sections}
      contactEmail="legal@aro.computer"
    />
  </SiteFrame>
</Site>
