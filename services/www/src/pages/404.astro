import Site from "@/layouts/Site.astro";
---

<Site canonical="https://ulo.sh">
  <meta slot="head" name="robots" content="noindex" />
  <div class="ulo-site">
    <main id="main" class="ulo-shell min-h-screen p-12">
      <p>ulo / 404</p>
      <h1 class="mt-8 text-2xl">Nothing here yet.</h1>
      <a class="ulo-text-link" href="/">
        {" "}
        Back to ulo{" "}
      </a>
    </main>
  </div>
</Site>
