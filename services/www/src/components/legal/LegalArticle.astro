---
/**
 * A narrow legal reading column with section anchors and a return to the
 * directory. `sections` lists the anchors in order; a section's content is
 * its trusted `html` string when given, otherwise the named slot matching its
 * `id`.
 */
interface Props {
  title: string;
  lead: string;
  sections: { id: string; title: string; html?: string }[];
}

const { title, lead, sections } = Astro.props;
---

<article class="ulo-legal-article">
  <a class="ulo-legal-back" href="/legal">
    {" "}
    Legal{" "}
  </a>
  <header>
    <h1>{title}</h1>
    <p>{lead}</p>
  </header>
  <nav class="ulo-legal-contents" aria-label="Page sections">
    {sections.map((section) => (
      <a href={`#${section.id}`}>{section.title}</a>
    ))}
  </nav>
  {sections.map((section) => (
    <section aria-labelledby={section.id}>
      <h2 id={section.id}>{section.title}</h2>
      <Fragment set:html={section.html ?? Astro.slots.render(section.id)} />
    </section>
  ))}
</article>
