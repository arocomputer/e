---
/**
 * ulo's own document: JetBrains Mono, light and dark chrome, the share card,
 * and the disclosure pointer handling every ulo page relies on. `title` is the
 * page's own name (`Docs`), rendered as `Docs | ulo`; `og`
 * gives a page its own card (docs, contact, legal) instead of the site's;
 * its description defaults to the page's.
 */
import "@fontsource-variable/jetbrains-mono";
import "@/styles/site.css";
import "@/styles/demo.css";

interface Props {
  title?: string;
  description?: string;
  canonical: string;
  og?: { title: string; description?: string; url: string };
}

const SITE = "https://ulo.sh";
const SITE_TITLE = "ulo | The coding agent you can put anywhere";
const SITE_DESCRIPTION =
  "The coding agent you can put anywhere. One Rust binary, your choice of model, and extensions in any language.";
const { title, description = SITE_DESCRIPTION, canonical, og } = Astro.props;
const fullTitle = title ? `${title} | ulo` : SITE_TITLE;
const image = `${SITE}/social`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="rgb(247 247 244)"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="rgb(16 15 12)"
    />
    <meta name="color-scheme" content="light dark" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {og ? (
      <>
        <meta property="og:title" content={og.title} />
        <meta
          property="og:description"
          content={og.description ?? description}
        />
        <meta property="og:url" content={og.url} />
      </>
    ) : (
      <>
        <meta property="og:title" content={SITE_TITLE} />
        <meta property="og:description" content={SITE_DESCRIPTION} />
        <meta property="og:url" content={SITE} />
        <meta property="og:site_name" content="ulo" />
        <meta property="og:image" content={image} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:type" content="website" />
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={SITE_TITLE} />
    <meta name="twitter:description" content={SITE_DESCRIPTION} />
    <meta name="twitter:image" content={image} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  /* Arial sized to JetBrains Mono's metrics, for glyphs the font lacks (→). */
  @font-face {
    font-family: "JetBrains Mono Fallback";
    src: local("Arial");
    ascent-override: 75.79%;
    descent-override: 22.29%;
    line-gap-override: 0%;
    size-adjust: 134.59%;
  }
  html {
    --ulo-mono: "JetBrains Mono Variable", "JetBrains Mono Fallback";
  }
</style>

<script>
  import "../scripts/disclosures";
</script>
