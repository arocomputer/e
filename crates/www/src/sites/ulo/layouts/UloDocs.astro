---
/**
 * The documentation shell: ulo's document with its own header, search, and a
 * workspace of sidebar, article, and page index. Documentation fills its own
 * workspace, independent of the landing-page frame. `current` is the internal
 * route (`/ulo/docs/...`) the navigation marks as the page; `title` is the
 * page's own name, and the share card repeats it.
 */
import Ulo from "./Ulo.astro";
import { Logo } from "@/sites/ulo/components/logo";
import DocsSidebar from "@/sites/ulo/components/docs/DocsSidebar.astro";
import { DocsSearch } from "@/sites/ulo/components/docs/search";
import { MobileDocsMenu } from "@/sites/ulo/components/docs/mobile-menu";
import { sidebar } from "@/sites/ulo/components/docs/data";
import "@/sites/ulo/styles/docs.css";
import "@/sites/ulo/styles/search.css";

interface Props {
  title: string;
  description: string;
  canonical: string;
  current: string;
}

const { title, description, canonical, current } = Astro.props;
const groups = sidebar();
---

<Ulo
  title={title}
  description={description}
  canonical={canonical}
  og={{ title: `${title} | ulo`, description, url: canonical }}
>
  <div class="ulo-site ulo-doc-site">
    <a class="ulo-skip" href="#main">
      {" "}
      Skip to content{" "}
    </a>
    <header class="ulo-doc-header">
      <a class="ulo-mark" aria-label="ulo home" href="/ulo">
        <Logo />
      </a>
      <DocsSearch client:load groups={groups} />
      <nav aria-label="Main">
        <a href="/ulo">Home</a>
        <a href="/ulo/changelog">Changelog</a>
        <a
          href="https://github.com/arocomputer/ulo"
          target="_blank"
          rel="noopener noreferrer"
        >
          GitHub
        </a>
      </nav>
      <MobileDocsMenu client:load groups={groups} current={current} />
    </header>
    <div class="ulo-doc-workspace">
      <DocsSidebar groups={groups} current={current} />
      <slot />
    </div>
  </div>
</Ulo>
