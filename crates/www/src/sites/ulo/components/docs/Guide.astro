---
/**
 * One guide as a page. The docs root and `/ulo/docs/<slug>` render this same
 * article inside the docs shell, so the markdown rendering and the page
 * metadata live here once. The `before` slot passes through to the article.
 * `installSection` names the section whose `install.sh` command block the
 * slot replaces, so a page can show the interactive installer where the
 * guide shows the plain command, instead of both.
 */
import UloDocs from "@/sites/ulo/layouts/UloDocs.astro";
import DocArticle from "./DocArticle.astro";
import { neighbours, publicDocPath, type Doc } from "./data";
import { renderMarkdown } from "./markdown";

interface Props {
  entry: Doc;
  installSection?: string;
}

const { entry, installSection } = Astro.props;
const INSTALL_BLOCK = /```(?:sh|bash|shell)?\n[^`]*install\.sh[^`]*```\n?/;
const body = (id: string, markdown: string) =>
  id === installSection ? markdown.replace(INSTALL_BLOCK, "") : markdown;
const { previous, next } = neighbours(entry.route);
---

<UloDocs
  title={entry.title}
  description={entry.description}
  canonical={`https://ulo.sh${publicDocPath(entry.route)}`}
  current={entry.route}
>
  <DocArticle
    title={entry.title}
    leadHtml={renderMarkdown(entry.lead || entry.description)}
    sections={entry.sections.map((section) => ({
      id: section.id,
      title: section.title,
      html: renderMarkdown(body(section.id, section.body)),
      subsections: section.subsections.map((sub) => ({
        id: sub.id,
        title: sub.title,
        html: renderMarkdown(sub.body),
      })),
    }))}
    previous={previous && { href: previous.route, title: previous.title }}
    next={next && { href: next.route, title: next.title }}
    slotSection={installSection}
  >
    <slot name="before" slot="before" />
  </DocArticle>
</UloDocs>
