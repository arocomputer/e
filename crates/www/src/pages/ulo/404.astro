---
/** A missing product URL keeps the visitor inside ulo's independent site. */
import Ulo from "@/sites/ulo/layouts/Ulo.astro";
---

<Ulo canonical="https://ulo.sh">
  <meta slot="head" name="robots" content="noindex" />
  <div class="ulo-site">
    <main id="main" class="ulo-shell min-h-screen p-12">
      <p>ulo / 404</p>
      <h1 class="mt-8 text-2xl">Nothing here yet.</h1>
      <a class="ulo-text-link" href="/ulo">
        {" "}
        Back to ulo{" "}
      </a>
    </main>
  </div>
</Ulo>
