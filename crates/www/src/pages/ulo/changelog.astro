---
/**
 * Release notes shared with GitHub, rendered per request from the release
 * list `cachedReleases` keeps for five minutes.
 */
import Ulo from "@/sites/ulo/layouts/Ulo.astro";
import SiteFrame from "@/sites/ulo/components/SiteFrame.astro";
import ReleaseText from "@/sites/ulo/components/ReleaseText.astro";
import { cachedReleases, groups } from "@/sites/ulo/data/releases";
import "@/sites/ulo/styles/changelog.css";

export const prerender = false;

const releases = await cachedReleases([]);
const date = new Intl.DateTimeFormat("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
});
Astro.response.headers.set("content-type", "text/html; charset=utf-8");
Astro.response.headers.set(
  "cache-control",
  "public, max-age=0, must-revalidate",
);
---

<Ulo
  title="Changelog"
  description="Published releases and improvements to ulo."
  canonical="https://ulo.sh/changelog"
>
  <SiteFrame>
    <article class="ulo-changelog">
      {releases.length === 0 && (
        <section>
          <h1>In development</h1>
          <p>
            There are no public releases available.{" "}
            <a href="/docs/install">Build from source</a> to try ulo.
          </p>
        </section>
      )}
      {releases.map((release, index) => {
        const id = `v${release.version.replaceAll(".", "-")}`;
        const url = release.url;
        const Heading = index === 0 ? "h1" : "h2";
        const GroupHeading = index === 0 ? "h2" : "h3";
        return (
          <section aria-labelledby={id}>
            <div class="ulo-changelog-meta">
              {url ? (
                <a href={url} target="_blank" rel="noopener noreferrer">
                  {release.version}
                </a>
              ) : (
                <span>{release.version}</span>
              )}
              <time datetime={release.publishedAt}>
                {date.format(new Date(release.publishedAt))}
              </time>
            </div>
            <div>
              <Heading id={id} class="ulo-release-title">
                <ReleaseText text={release.title} />
              </Heading>
              <p>
                <ReleaseText text={release.intro} />
              </p>
              {groups
                .filter((group) => release.groups[group].length)
                .map((group) => (
                  <div>
                    <GroupHeading>{group}</GroupHeading>
                    <ul>
                      {release.groups[group].map((item) => (
                        <li>
                          <ReleaseText text={item} />
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              {url && (
                <p>
                  <a href={url}>Release notes and downloads</a>
                </p>
              )}
            </div>
          </section>
        );
      })}
    </article>
  </SiteFrame>
</Ulo>
