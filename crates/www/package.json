{
  "name": "@arocomputer/ulo-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/ulo/docs/index-docs.mjs",
    "preview": "npm run build && node scripts/preview.mjs",
    "deploy": "npm run build && wrangler deploy",
    "lint": "eslint",
    "typecheck": "astro check",
    "cf-typegen": "wrangler types",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --experimental-strip-types --test tests/contact/*.test.mjs tests/email/*.test.mjs tests/ulo/playback.test.mjs tests/ulo/releases.test.mjs tests/ulo/docs.test.mjs",
    "test:recording": "python3 -B -m unittest discover -s tests/ulo -p 'test_*.py'",
    "test:routes": "node --test tests/routing/hosts.test.mjs",
    "prebuild": "npm run docs",
    "predev": "npm run docs",
    "pretypecheck": "npm run docs && wrangler types",
    "docs": "node scripts/ulo/docs/docs.mjs",
    "social": "node scripts/ulo/social/render.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.2",
    "@astrojs/react": "5.0.1",
    "@fontsource-variable/jetbrains-mono": "^5",
    "@fontsource-variable/montserrat": "^5",
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/vite": "^4",
    "astro": "7.3.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-highlight": "^7.0.2",
    "rehype-stringify": "^10",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11",
    "remark-rehype": "^11",
    "satori": "0.33.4",
    "tailwindcss": "^4",
    "unified": "^11"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9",
    "@eslint/js": "^10",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-plugin-astro": "^3",
    "eslint-plugin-react-hooks": "^7",
    "pagefind": "1.5.2",
    "prettier": "3.9.8",
    "prettier-plugin-astro": "^1.0",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "wrangler": "4.135.0"
  }
}
