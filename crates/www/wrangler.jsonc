// The product website. Aro retains shared email credentials and delivery.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ulo",
  "account_id": "15a2d3f1e6ab03432b2037945113c421",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/@*", "!/node_modules/*", "!/src/*"],
  },
  "routes": [
    { "pattern": "ulo.sh", "custom_domain": true },
    { "pattern": "www.ulo.sh", "custom_domain": true },
  ],
  "services": [{ "binding": "CONTACT_SERVICE", "service": "aro" }],
  "durable_objects": {
    "bindings": [{ "name": "RATE_LIMITER", "class_name": "RateLimiter" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RateLimiter"] }],
  "observability": { "enabled": true },
}
