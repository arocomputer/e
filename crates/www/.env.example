# Worker configuration for /api/contact, /api/form-token, and /api/unsubscribe.
# See docs/contact.md for behavior when a value is missing.
#
# Locally: copy the values you need into .dev.vars (git-ignored); the preview
# Worker reads it. In production: `npx wrangler secret put NAME` for each value.
# The build never sees these. Never commit real credentials.

# Contact notification: sending-only Resend key and verified sender.
RESEND_API_KEY=
CONTACT_FROM=Aro <noreply@aro.computer>
CONTACT_TO=contact@aro.computer

# Timing tokens: dedicated key preferred; falls back to UNSUBSCRIBE_SECRET.
# Generate secrets with: openssl rand -base64 32
FORM_TOKEN_SECRET=
UNSUBSCRIBE_SECRET=

# Contact-list access for opt-in and unsubscribe operations.
# Falls back to RESEND_API_KEY; use a separate scoped key in production.
RESEND_CONTACTS_API_KEY=

# Absolute origin for outgoing unsubscribe links.
SITE_URL=https://aro.computer

# Marketing sender falls back to CONTACT_FROM. Replies are optional.
MARKETING_FROM=
MARKETING_REPLY_TO=contact@aro.computer

# Required for marketing messages. Set the operator's real postal address.
MARKETING_POSTAL_ADDRESS=
