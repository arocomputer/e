#!/bin/sh
# Locate the platform dependency installed by npm or bun, then hand over the terminal.
set -eu
entry=$0
while [ -L "$entry" ]; do
  parent=$(CDPATH= cd -P "$(dirname "$entry")" && pwd)
  entry=$(readlink "$entry")
  case "$entry" in /*) ;; *) entry="$parent/$entry" ;; esac
done
root=$(CDPATH= cd -P "$(dirname "$entry")/.." && pwd)
case "$(uname -s)" in Darwin) os=darwin ;; Linux) os=linux ;; *) echo 'ulo supports macOS and glibc Linux.' >&2; exit 1 ;; esac
case "$(uname -m)" in arm64|aarch64) cpu=arm64 ;; x86_64|amd64) cpu=x64 ;; *) echo 'ulo supports ARM64 and x86-64.' >&2; exit 1 ;; esac
name="ulo-$os-$cpu"
for binary in "$root/node_modules/@arocomputer/$name/bin/ulo" "$root/../$name/bin/ulo"; do
  if [ -x "$binary" ]; then exec "$binary" "$@"; fi
done
echo "Missing @arocomputer/$name. Reinstall @arocomputer/ulo with optional dependencies enabled. Linux requires glibc." >&2
exit 1
