{
  "name": "@arocomputer/ulo-slack",
  "version": "0.0.2",
  "description": "A Slack bot that runs ulo: one thread, one session, over `ulo rpc`",
  "type": "module",
  "license": "MIT",
  "homepage": "https://ulo.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arocomputer/ulo.git",
    "directory": "channels/slack"
  },
  "bugs": "https://github.com/arocomputer/ulo/issues",
  "keywords": [
    "slack",
    "slack-bot",
    "coding-agent",
    "agent"
  ],
  "bin": {
    "ulo-slack": "bin/ulo-slack.js"
  },
  "engines": {
    "node": ">=22.6"
  },
  "files": [
    "bin",
    "src",
    "!src/*.test.ts",
    ".env.example",
    "manifest.json"
  ],
  "scripts": {
    "start": "node --experimental-strip-types src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/*.test.ts"
  },
  "dependencies": {
    "@slack/bolt": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
