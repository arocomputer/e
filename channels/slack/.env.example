# Slack app credentials (api.slack.com/apps → your app). Socket mode needs
# all three; no public URL.
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
SLACK_APP_TOKEN=xapp-...

# The checkout ulo works in. One bot, one repository; run one bot per repo.
ULO_CWD=/srv/checkouts/app

# Optional: the ulo binary (default: `ulo` on PATH), a model, and where the
# thread → session map is kept so threads survive a restart.
# ULO_BIN=/usr/local/bin/ulo
# ULO_MODEL=anthropic/claude-opus-5
# ULO_SLACK_STATE=./ulo-slack-state.json
